---
import {
  asset,
  depoimentos,
  faq,
  historia,
  numeros,
  portfolio,
  servicos,
  site,
} from "../data/site";

const icones: Record<string, string> = {
  estrutura: "M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6",
  obra: "M2 20h20M5 20V10h6v10M11 20V4l9 6v10M14 14h3",
  laudo: "M9 3h6l4 4v14H5V3h4zM9 13l2 2 4-4",
  reforma: "M14 6l4 4M3 21l4-1 11-11-3-3L4 17l-1 4z",
};
---

<!-- NÚMEROS -->
<section class="relative bg-marinho-900 text-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-5 py-10 sm:py-12 lg:grid-cols-4">
    {numeros.map((n) => (
      <div class="reveal px-3 py-4 text-center">
        <div class="font-display text-4xl font-extrabold text-obra sm:text-5xl">{n.valor}</div>
        <div class="mt-1 text-xs tracking-wide text-white/75 uppercase sm:text-sm">{n.rotulo}</div>
      </div>
    ))}
  </div>
  <p class="pb-3 text-center text-[11px] text-white/40">Números ilustrativos (a confirmar)</p>
</section>

<!-- SERVIÇOS -->
<section id="servicos" class="blueprint-claro py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-bold tracking-[0.2em] text-obra-600 uppercase">Serviços</p>
      <h2 class="mt-3 text-3xl font-extrabold text-marinho-900 sm:text-4xl">Engenharia que sai do papel com segurança</h2>
      <p class="mt-4 text-suave">Do cálculo à entrega, cada etapa é acompanhada de perto e explicada de forma clara.</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {servicos.map((s) => (
        <article class="reveal group border-t-4 border-obra bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
          <div class="flex h-12 w-12 items-center justify-center bg-marinho-900 text-obra">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icones[s.icone]} /></svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-marinho-900">{s.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-suave">{s.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- HISTÓRIA -->
<section id="historia" class="blueprint relative overflow-hidden bg-marinho-900 py-20 text-white sm:py-28">
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-bold tracking-[0.2em] text-obra uppercase">Minha história</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">História ilustrativa para validação</h2>
    </div>
    <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {historia.map((h, i) => (
        <li class="reveal relative border-l-2 border-obra/60 pl-6">
          <span class="absolute -left-[13px] top-0 flex h-6 w-6 items-center justify-center rounded-full bg-obra text-xs font-extrabold text-marinho-950">{i + 1}</span>
          <p class="text-xs font-bold tracking-widest text-obra uppercase">{h.ano}</p>
          <h3 class="mt-1 text-xl font-bold">{h.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/80">{h.texto}</p>
        </li>
      ))}
    </ol>
    <p class="mt-10 text-xs text-white/40">Texto ilustrativo: substituir pela trajetória real.</p>
  </div>
</section>

<!-- SOBRE -->
<section id="sobre" class="py-20 sm:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 lg:grid-cols-2">
    <div class="reveal relative mx-auto w-full max-w-md">
      <div class="absolute -right-4 -bottom-4 h-full w-full border-4 border-obra" aria-hidden="true"></div>
      <img src={asset("img/retrato-simulado.svg")} alt="Retrato ilustrativo de engenheiro civil de capacete (foto simulada)" width="600" height="750" loading="lazy" class="relative aspect-[4/5] w-full object-cover" />
    </div>
    <div class="reveal">
      <p class="text-sm font-bold tracking-[0.2em] text-obra-600 uppercase">Sobre</p>
      <h2 class="mt-3 text-3xl font-extrabold text-marinho-900 sm:text-4xl">{site.nome}, engenheiro civil</h2>
      <p class="mt-5 leading-relaxed text-suave">
        Nesta prévia, esta área mostra uma proposta de apresentação profissional. Formação, serviços e forma de atendimento
        serão confirmados com Tiago antes da versão final.
      </p>
      <ul class="mt-6 space-y-3 text-texto">
        {["Atendimento a confirmar", "Orçamento a definir", "Responsabilidade técnica a confirmar"].map((t) => (
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 shrink-0 bg-obra"></span>{t}</li>
        ))}
      </ul>
      <p class="mt-6 inline-block border border-marinho-900/15 bg-white px-4 py-2 text-sm font-semibold text-marinho-900">{site.crea}</p>
      <p class="mt-3 text-xs text-suave">Imagem ilustrativa e registro CREA a confirmar.</p>
    </div>
  </div>
</section>

<!-- PORTFÓLIO -->
<section id="portfolio" class="bg-concreto-200 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-bold tracking-[0.2em] text-obra-600 uppercase">Portfólio</p>
      <h2 class="mt-3 text-3xl font-extrabold text-marinho-900 sm:text-4xl">Exemplos visuais de trabalhos</h2>
      <p class="mt-3 text-xs text-suave">Imagens ilustrativas. Serão trocadas por obras reais.</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {portfolio.map((p) => (
        <figure class="reveal group overflow-hidden bg-white shadow-sm">
          <div class="aspect-[4/3] overflow-hidden"><img src={p.img} alt="" loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div>
          <figcaption class="p-5">
            <p class="text-xs font-bold tracking-widest text-obra-600 uppercase">{p.tipo}</p>
            <p class="mt-1 font-display font-bold text-marinho-900">{p.titulo}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- DEPOIMENTOS -->
<section id="depoimentos" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-bold tracking-[0.2em] text-obra-600 uppercase">Depoimentos</p>
      <h2 class="mt-3 text-3xl font-extrabold text-marinho-900 sm:text-4xl">Quem confiou, recomenda</h2>
      <p class="mt-3 text-xs text-suave">Exemplos ilustrativos. Não são clientes reais.</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {depoimentos.map((d) => (
        <blockquote class="reveal border-l-4 border-obra bg-white p-7 shadow-sm">
          <p class="leading-relaxed text-texto">“{d.texto}”</p>
          <footer class="mt-5 text-sm"><strong class="text-marinho-900">{d.nome}</strong><br /><span class="text-suave">{d.papel}</span></footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-5">
    <div class="reveal text-center">
      <p class="text-sm font-bold tracking-[0.2em] text-obra-600 uppercase">Dúvidas</p>
      <h2 class="mt-3 text-3xl font-extrabold text-marinho-900 sm:text-4xl">Perguntas frequentes</h2>
    </div>
    <div class="mt-10 divide-y divide-concreto-200 border-y border-concreto-200">
      {faq.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-bold text-marinho-900">
            {f.p}
            <span class="text-2xl text-obra transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-suave">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CONTATO -->
<section id="contato" class="relative isolate overflow-hidden py-20 text-white sm:py-28">
  <div class="absolute inset-0 -z-20 bg-gradient-to-br from-marinho-950 via-marinho-900 to-marinho-800"></div>
  <img src={asset("img/hero-sao-paulo.svg")} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-20" loading="lazy" />
  <div class="blueprint absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2">
    <div class="reveal">
      <p class="text-sm font-bold tracking-[0.2em] text-obra uppercase">Contato</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-5xl">Seu projeto está a poucos passos de sair do papel</h2>
      <p class="mt-5 max-w-lg text-white/80">Os canais de contato serão definidos com Tiago. Este formulário é apenas uma demonstração visual.</p>
      <div class="mt-8 flex items-center gap-4">
        <img src={asset("img/retrato-simulado.svg")} alt="" width="64" height="64" class="h-16 w-16 rounded-full border-2 border-obra object-cover object-top" />
        <div>
          <p class="font-bold">{site.nome}</p>
          <p class="text-sm text-white/70">{site.titulo} · {site.cidade}</p>
        </div>
      </div>
      <ul class="mt-8 space-y-2 text-sm text-white/85">
        <li>WhatsApp: <strong>{site.whatsappExibicao}</strong></li>
        <li>E-mail: <strong>a confirmar</strong></li>
      </ul>
      <p class="mt-3 text-xs text-white/70">Os contatos ainda não estão ativos nesta prévia.</p>
    </div>

    <form id="form-contato" class="reveal bg-white/5 p-6 ring-1 ring-white/15 backdrop-blur sm:p-8" novalidate>
      <p class="mb-5 border-l-4 border-obra pl-3 text-sm font-semibold">Formulário ilustrativo. Não informe dados reais: nada será enviado.</p>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium">Nome
          <input name="nome" required autocomplete="name" class="mt-1.5 w-full border border-white/30 bg-transparent px-4 py-3 text-white placeholder:text-white/40 focus:border-obra" placeholder="Seu nome" />
        </label>
        <label class="block text-sm font-medium">WhatsApp
          <input name="telefone" required inputmode="tel" autocomplete="tel" class="mt-1.5 w-full border border-white/30 bg-transparent px-4 py-3 text-white placeholder:text-white/40 focus:border-obra" placeholder="(11) 90000-0000" />
        </label>
        <label class="block text-sm font-medium sm:col-span-2">E-mail
          <input name="email" type="email" autocomplete="email" class="mt-1.5 w-full border border-white/30 bg-transparent px-4 py-3 text-white placeholder:text-white/40 focus:border-obra" placeholder="voce@email.com" />
        </label>
        <label class="block text-sm font-medium">Serviço
          <select name="servico" class="mt-1.5 w-full border border-white/30 bg-marinho-900 px-4 py-3 text-white focus:border-obra">
            {servicos.map((s) => <option>{s.titulo}</option>)}
            <option>Outro</option>
          </select>
        </label>
        <label class="block text-sm font-medium">Cidade
          <input name="cidade" class="mt-1.5 w-full border border-white/30 bg-transparent px-4 py-3 text-white placeholder:text-white/40 focus:border-obra" placeholder="Sua cidade" />
        </label>
        <label class="block text-sm font-medium sm:col-span-2">Mensagem
          <textarea name="mensagem" rows="4" class="mt-1.5 w-full border border-white/30 bg-transparent px-4 py-3 text-white placeholder:text-white/40 focus:border-obra" placeholder="Descreva rapidamente o que precisa"></textarea>
        </label>
        <input type="text" name="empresa_site" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      </div>
      <label class="mt-5 flex items-start gap-3 text-xs text-white/70">
        <input type="checkbox" name="lgpd" required class="mt-0.5 h-4 w-4 accent-orange-500" />
        Entendo que este formulário é uma demonstração e não envia dados.
      </label>
      <button type="submit" class="mt-6 w-full rounded-sm bg-obra px-6 py-4 font-bold text-marinho-950 transition hover:bg-obra-600">Testar formulário sem envio</button>
      <p id="form-status" role="status" class="mt-4 min-h-5 text-sm text-obra"></p>
      <p class="mt-1 text-[11px] text-white/40">Modo demonstração: o envio ainda não está conectado (será ligado ao n8n).</p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("form-contato") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!status) return;
    const d = new FormData(form);
    if (d.get("empresa_site")) return; // honeypot anti-spam
    if (!form.checkValidity()) {
      status.textContent = "Preencha nome, WhatsApp e aceite o termo para continuar.";
      form.reportValidity();
      return;
    }
    status.textContent = "Demonstração concluída. Nenhum dado foi enviado.";
    form.reset();
  });
</script>
