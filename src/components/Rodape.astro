---
import { asset, menu, site, whatsappLink } from "../data/site";

const ano = new Date().getFullYear();
---

<footer class="bg-marinho-950 text-white/75">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src={asset("img/logo-marca.svg")} alt="" width="40" height="40" class="h-10 w-10" />
        <div class="leading-tight">
          <p class="font-display font-extrabold text-white">{site.nome}</p>
          <p class="text-[11px] font-semibold tracking-[0.18em] text-obra uppercase">{site.titulo}</p>
        </div>
      </div>
      <p class="mt-4 text-sm">{site.assinatura}</p>
    </div>
    <nav aria-label="Rodapé">
      <p class="font-bold text-white">Navegação</p>
      <ul class="mt-3 space-y-2 text-sm">
        {menu.map((m) => <li><a href={m.href} class="hover:text-obra">{m.rotulo}</a></li>)}
      </ul>
    </nav>
    <div class="text-sm">
      <p class="font-bold text-white">Fale comigo</p>
      <ul class="mt-3 space-y-2">
        <li>WhatsApp: {site.whatsappExibicao}</li>
        <li>E-mail: a confirmar</li>
        <li>{site.crea}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs text-white/50">
    © {ano} {site.nome} · {site.titulo}. Todos os direitos reservados.
  </div>
</footer>

{site.whatsapp && (
  <a
    href={whatsappLink()}
    aria-label="Falar no WhatsApp"
    class="fixed right-4 bottom-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition hover:scale-105 sm:right-6 sm:bottom-6"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7a11 11 0 0 1-4.6-4.1c-.5-.7-1.1-1.700-1.100-2.700s.5-1.500.7-1.700c.2-.2.4-.2.6-.2h.4c.1 0 .3 0 .5.4l.8 1.900c.1.200.1.300 0 .5l-.3.400-.3.400c-.1.100-.2.300-.1.500.5.900 1.200 1.600 2 2.100.7.400 1.200.6 1.400.7.200.1.400.1.500-.1l.7-.9c.2-.2.300-.2.500-.1l1.800.9c.2.100.4.200.4.300.1.200.1.700-.1 1.300z" /></svg>
  </a>
)}
