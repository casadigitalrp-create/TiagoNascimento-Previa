---
import { asset, menu, site, whatsappLink } from "../data/site";
---

<header id="topo" class="fixed inset-x-0 top-0 z-50 border-b border-concreto-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-5">
    <a href="#topo" class="flex items-center gap-3" aria-label={`${site.nome} ${site.titulo} - início`}>
      <img src={asset("img/logo-marca.svg")} alt="" width="40" height="40" class="h-10 w-10" />
      <span class="leading-tight">
        <span class="block font-display text-[15px] font-extrabold tracking-tight text-marinho-900">{site.nome}</span>
        <span class="block text-[11px] font-semibold tracking-[0.18em] text-obra-600 uppercase">{site.titulo}</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-7 lg:flex">
      {
        menu.map((m) => (
          <a href={m.href} class="text-sm font-medium text-texto transition-colors hover:text-obra-600">
            {m.rotulo}
          </a>
        ))
      }
      <a
        href={whatsappLink()}
        class="rounded-sm bg-obra px-5 py-2.5 text-sm font-bold text-marinho-950 transition hover:bg-obra-600"
        >Ver contato</a
      >
    </nav>

    <button
      id="btn-menu"
      class="flex h-11 w-11 items-center justify-center rounded border border-concreto-200 lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>

  <nav id="menu-mobile" aria-label="Menu mobile" class="hidden border-t border-concreto-200 bg-white px-5 pb-5 lg:hidden">
    <ul class="flex flex-col">
      {
        menu.map((m) => (
          <li>
            <a href={m.href} class="block border-b border-concreto-200 py-3.5 font-medium">
              {m.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={whatsappLink()} class="mt-4 block rounded-sm bg-obra px-5 py-3 text-center font-bold text-marinho-950">
      Ver contato
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById("btn-menu");
  const menu = document.getElementById("menu-mobile");
  if (btn && menu) {
    const alternar = (abrir: boolean) => {
      menu.classList.toggle("hidden", !abrir);
      btn.setAttribute("aria-expanded", String(abrir));
      btn.setAttribute("aria-label", abrir ? "Fechar menu" : "Abrir menu");
    };
    btn.addEventListener("click", () => alternar(menu.classList.contains("hidden")));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => alternar(false)));
  }
</script>
